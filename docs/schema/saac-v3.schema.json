{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sequenciaac.app/schema/saac-v3.schema.json",
  "title": "SequenciAAC — document (.saac) i estil (.saacstyle), esquema 3",
  "description": "Vegeu docs/fonaments/06-compatibilitat-i-dades.md. Els camps desconeguts s'admeten a tots els nivells i es conserven en tornar a desar.",
  "oneOf": [
    {
      "$ref": "#/$defs/documentFile"
    },
    {
      "$ref": "#/$defs/styleFile"
    }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "format",
        "kind",
        "schemaVersion"
      ],
      "properties": {
        "format": {
          "const": "sequenciaac"
        },
        "kind": {
          "enum": [
            "document",
            "style"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 3
        },
        "savedWith": {
          "type": "string",
          "description": "Versió de l'app que el va escriure. Només informa."
        }
      }
    },
    "documentFile": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        }
      ],
      "type": "object",
      "required": [
        "format",
        "kind",
        "schemaVersion",
        "meta",
        "page",
        "style",
        "sequences"
      ],
      "properties": {
        "kind": {
          "const": "document"
        },
        "meta": {
          "$ref": "#/$defs/documentMeta"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "style": {
          "$ref": "#/$defs/fullStyle"
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/asset"
          }
        },
        "ui": {
          "type": "object",
          "description": "Estat d'edició. Mai no afecta l'aspecte ni la impressió.",
          "properties": {
            "activeSequence": {
              "type": "string"
            }
          }
        }
      }
    },
    "styleFile": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        }
      ],
      "type": "object",
      "required": [
        "format",
        "kind",
        "schemaVersion",
        "style"
      ],
      "properties": {
        "kind": {
          "const": "style"
        },
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "style": {
          "$ref": "#/$defs/fullStyle"
        }
      }
    },
    "documentMeta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "size",
        "orientation",
        "direction",
        "sequenceGap",
        "layout"
      ],
      "properties": {
        "size": {
          "enum": [
            "A4",
            "A3",
            "LETTER",
            "TABLOID",
            "FULLSCREEN"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ],
          "description": "Seqüències en files o en columnes."
        },
        "sequenceGap": {
          "type": "number",
          "minimum": 0,
          "description": "Espai entre seqüències. És un factor, no mil·límetres."
        },
        "layout": {
          "enum": [
            "flow",
            "free"
          ],
          "description": "\"flow\": les seqüències es col·loquen soles. \"free\": mode lliure, on diuen sheets i common (docs/decisions/ADR-005-disposicio-lliure.md)."
        },
        "sheets": {
          "type": "array",
          "description": "Només amb layout = \"free\": les pàgines del document, en ordre. Sense cap full, la disposició es torna a construir en obrir-lo.",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        },
        "common": {
          "type": "array",
          "description": "Només amb layout = \"free\": col·locacions que surten a totes les pàgines, al mateix lloc, per sota de les de cada full.",
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      }
    },
    "sheet": {
      "type": "object",
      "description": "Una pàgina del mode lliure.",
      "required": [
        "id",
        "placements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "description": "Una seqüència posada en una pàgina. Una seqüència pot tenir moltes col·locacions, a pàgines diferents o a la mateixa. Mil·límetres des del cantó superior esquerre del full (el paper menys el marge d'impressió).",
      "required": [
        "id",
        "sequence",
        "x",
        "y",
        "w",
        "h",
        "columns"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "description": "L'id de la seqüència. Una col·locació d'una seqüència que no hi és es descarta en llegir."
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "columns": {
          "description": "Columnes de la graella: \"auto\" (les que fan els pictogrames més grans) o un nombre fix.",
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    },
    "sequence": {
      "type": "object",
      "required": [
        "id",
        "pictograms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "style": {
          "type": "object",
          "description": "En aquesta versió, només view. Només les diferències amb l'estil del document.",
          "properties": {
            "view": {
              "$ref": "#/$defs/partialView"
            }
          }
        },
        "pictograms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pictogram"
          }
        }
      }
    },
    "pictogram": {
      "type": "object",
      "required": [
        "id",
        "word",
        "image"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "word": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "cross": {
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/fitzgeraldCategory",
          "description": "Només si el pictograma en té."
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "style": {
          "type": "object",
          "description": "Només les diferències amb l'estil resolt de la seqüència. Mai view.",
          "properties": {
            "pictogram": {
              "$ref": "#/$defs/partialPictogramStyle"
            },
            "card": {
              "$ref": "#/$defs/partialCardStyle"
            }
          },
          "not": {
            "required": [
              "view"
            ]
          }
        }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source",
            "id"
          ],
          "properties": {
            "source": {
              "const": "arasaac"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variants": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "skin",
                  "hair",
                  "color"
                ]
              },
              "description": "Les opcions d'aparença que admet aquest pictograma d'ARASAAC (no tots tenen pell o cabell). És contingut. Sense la llista, les admet totes."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "asset"
          ],
          "properties": {
            "source": {
              "const": "own"
            },
            "asset": {
              "type": "string"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "description": "El pictograma d'ARASAAC que la imatge pròpia substitueix, per si es treu."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "none"
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "mime"
      ],
      "anyOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "mime": {
          "type": "string",
          "pattern": "^image/"
        },
        "data": {
          "type": "string",
          "pattern": "^data:image/"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "skin": {
      "enum": [
        "asian",
        "aztec",
        "black",
        "mulatto",
        "white"
      ]
    },
    "hair": {
      "enum": [
        "black",
        "blonde",
        "brown",
        "darkBrown",
        "gray",
        "darkGray",
        "red"
      ]
    },
    "textPosition": {
      "enum": [
        "top",
        "bottom",
        "none"
      ]
    },
    "alignmentH": {
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "alignmentV": {
      "enum": [
        "top",
        "center",
        "bottom"
      ]
    },
    "fitzgeraldCategory": {
      "enum": [
        "properNoun",
        "noun",
        "verb",
        "descriptive",
        "socialContent",
        "miscellaneous"
      ],
      "description": "Categoria de Fitzgerald de la paraula. És contingut, no estil."
    },
    "fitzgeraldColors": {
      "type": "object",
      "description": "Color de cada categoria de Fitzgerald, i `none` per als pictogrames sense categoria.",
      "required": [
        "properNoun",
        "noun",
        "verb",
        "descriptive",
        "socialContent",
        "miscellaneous",
        "none"
      ],
      "properties": {
        "properNoun": {
          "type": "string"
        },
        "noun": {
          "type": "string"
        },
        "verb": {
          "type": "string"
        },
        "descriptive": {
          "type": "string"
        },
        "socialContent": {
          "type": "string"
        },
        "miscellaneous": {
          "type": "string"
        },
        "none": {
          "type": "string"
        }
      }
    },
    "font": {
      "type": "object",
      "required": [
        "family",
        "color",
        "size"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "partialFont": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "border": {
      "type": "object",
      "required": [
        "color",
        "radius",
        "size"
      ],
      "properties": {
        "color": {
          "type": "string",
          "description": "Un color, o \"fitzgerald\"."
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "size": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "partialBorder": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "size": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fullStyle": {
      "type": "object",
      "description": "Estil del document o d'un fitxer d'estil: sempre complet.",
      "required": [
        "pictogram",
        "card",
        "view"
      ],
      "properties": {
        "pictogram": {
          "type": "object",
          "required": [
            "skin",
            "hair",
            "color",
            "fitzgerald"
          ],
          "properties": {
            "skin": {
              "$ref": "#/$defs/skin"
            },
            "hair": {
              "$ref": "#/$defs/hair"
            },
            "color": {
              "type": "boolean"
            },
            "fitzgerald": {
              "$ref": "#/$defs/fitzgeraldColors"
            }
          }
        },
        "card": {
          "type": "object",
          "required": [
            "numbered",
            "textPosition",
            "font",
            "numberFont",
            "borderIn",
            "borderOut"
          ],
          "properties": {
            "numbered": {
              "type": "boolean"
            },
            "textPosition": {
              "$ref": "#/$defs/textPosition"
            },
            "font": {
              "$ref": "#/$defs/font"
            },
            "numberFont": {
              "$ref": "#/$defs/font"
            },
            "borderIn": {
              "$ref": "#/$defs/border"
            },
            "borderOut": {
              "$ref": "#/$defs/border"
            }
          }
        },
        "view": {
          "type": "object",
          "required": [
            "sizePict",
            "pictSpaceBetween",
            "alignmentH",
            "alignmentV"
          ],
          "properties": {
            "sizePict": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pictSpaceBetween": {
              "type": "number",
              "minimum": 0
            },
            "alignmentH": {
              "$ref": "#/$defs/alignmentH"
            },
            "alignmentV": {
              "$ref": "#/$defs/alignmentV"
            }
          }
        }
      }
    },
    "partialPictogramStyle": {
      "type": "object",
      "properties": {
        "skin": {
          "$ref": "#/$defs/skin"
        },
        "hair": {
          "$ref": "#/$defs/hair"
        },
        "color": {
          "type": "boolean"
        },
        "fitzgerald": {
          "type": "string",
          "description": "Retoc: un sol color, que substitueix el de la categoria."
        }
      }
    },
    "partialCardStyle": {
      "type": "object",
      "properties": {
        "numbered": {
          "type": "boolean"
        },
        "textPosition": {
          "$ref": "#/$defs/textPosition"
        },
        "font": {
          "$ref": "#/$defs/partialFont"
        },
        "numberFont": {
          "$ref": "#/$defs/partialFont"
        },
        "borderIn": {
          "$ref": "#/$defs/partialBorder"
        },
        "borderOut": {
          "$ref": "#/$defs/partialBorder"
        }
      }
    },
    "partialView": {
      "type": "object",
      "properties": {
        "sizePict": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pictSpaceBetween": {
          "type": "number",
          "minimum": 0
        },
        "alignmentH": {
          "$ref": "#/$defs/alignmentH"
        },
        "alignmentV": {
          "$ref": "#/$defs/alignmentV"
        }
      }
    }
  }
}
