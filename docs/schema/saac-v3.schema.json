{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sequenciaac.app/schema/saac-v3.schema.json",
  "title": "SequenciAAC — document (.saac) i estil (.saacstyle), esquema 3",
  "description": "Vegeu docs/fonaments/06-compatibilitat-i-dades.md. Els camps desconeguts s'admeten a tots els nivells i es conserven en tornar a desar.",
  "oneOf": [
    {
      "$ref": "#/$defs/documentFile"
    },
    {
      "$ref": "#/$defs/styleFile"
    }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "format",
        "kind",
        "schemaVersion"
      ],
      "properties": {
        "format": {
          "const": "sequenciaac"
        },
        "kind": {
          "enum": [
            "document",
            "style"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 3
        },
        "savedWith": {
          "type": "string",
          "description": "Versió de l'app que el va escriure. Només informa."
        }
      }
    },
    "documentFile": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        }
      ],
      "type": "object",
      "required": [
        "format",
        "kind",
        "schemaVersion",
        "meta",
        "page",
        "style",
        "sequences"
      ],
      "properties": {
        "kind": {
          "const": "document"
        },
        "meta": {
          "$ref": "#/$defs/documentMeta"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "style": {
          "$ref": "#/$defs/fullStyle"
        },
        "sequences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/asset"
          }
        },
        "ui": {
          "type": "object",
          "description": "Estat d'edició. Mai no afecta l'aspecte ni la impressió.",
          "properties": {
            "activeSequence": {
              "type": "string"
            }
          }
        },
        "styles": {
          "type": "array",
          "description": "Estils amb nom del document: retocs de l'estil del document que poden fer servir molts blocs alhora (namedStyle). És l'entrada del catàleg d'estils copiada dins del document (docs/decisions/ADR-005-disposicio-lliure.md).",
          "items": {
            "$ref": "#/$defs/namedStyle"
          }
        }
      }
    },
    "styleFile": {
      "allOf": [
        {
          "$ref": "#/$defs/header"
        }
      ],
      "type": "object",
      "required": [
        "format",
        "kind",
        "schemaVersion",
        "style"
      ],
      "properties": {
        "kind": {
          "const": "style"
        },
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "style": {
          "$ref": "#/$defs/fullStyle"
        }
      }
    },
    "documentMeta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "page": {
      "type": "object",
      "required": [
        "size",
        "orientation",
        "direction",
        "sequenceGap",
        "layout"
      ],
      "properties": {
        "size": {
          "enum": [
            "A4",
            "A3",
            "LETTER",
            "TABLOID",
            "FULLSCREEN"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ],
          "description": "La direcció de les pàgines automàtiques que no en diuen cap: seqüències en files o en columnes."
        },
        "sequenceGap": {
          "type": "number",
          "minimum": 0,
          "description": "Espai entre blocs (entre seqüències al flux). És un factor, no mil·límetres."
        },
        "layout": {
          "enum": [
            "flow",
            "free"
          ],
          "description": "Obsolet: s'escriu sempre \"flow\", perquè les versions anteriors el llegeixen. \"free\" només el porten els fitxers de les fases 1–3 del mode lliure; ara és cada pàgina (sheets[].mode) la que diu com es col·loquen els blocs."
        },
        "sheets": {
          "type": "array",
          "description": "Les pàgines del document, en ordre. Sense sheets, el document és una sola pàgina automàtica amb totes les seqüències. Es llegeixen sempre que hi siguin, digui el que digui layout.",
          "items": {
            "$ref": "#/$defs/sheet"
          }
        },
        "common": {
          "type": "array",
          "description": "Blocs que surten a totes les pàgines, al mateix lloc, per sota dels de cada pàgina. Sempre amb caixa.",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "licenceOn": {
          "enum": [
            "every",
            "last"
          ],
          "description": "A quines pàgines va el peu de llicència. Sense valor, a totes; l'app només escriu \"last\"."
        }
      }
    },
    "sheet": {
      "type": "object",
      "description": "Una pàgina del document. L'app escriu sempre mode i blocks; els fulls de les fases 1–3 no portaven mode i deien placements els blocs.",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "auto",
            "template"
          ],
          "description": "\"auto\": els blocs un darrere l'altre, com el flux de sempre (sense caixes). \"template\": cada bloc a la seva caixa. Si falta o no s'entén, \"template\" si algun bloc que l'app entén té caixa, i si no \"auto\"."
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ],
          "description": "Només en automàtica. Sense valor, la de page.direction."
        },
        "sequenceGap": {
          "type": "number",
          "description": "Només en automàtica: l'espai entre seqüències d'aquesta pàgina. Sense valor, el de page.sequenceGap."
        },
        "template": {
          "type": "string",
          "description": "La plantilla de la pàgina (R2): \"full\", \"rows-N\", \"columns-N\", \"grid-CxR\", \"strip-top\" o les dels treballs reals (R3): \"agenda-strip\", \"today-agenda\", \"first-then\", \"week\", \"token-board\", \"story-page\", \"menu\". Algunes tenen espais de rètol, on van els blocs de text. Es recorda també en automàtica. Un id que l'app no coneix es conserva."
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "placements": {
          "type": "array",
          "description": "Obsolet: el nom de blocks a les fases 1–3. Es llegeix si no hi ha blocks i no es torna a escriure.",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "sequence": {
      "type": "object",
      "required": [
        "id",
        "pictograms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "style": {
          "type": "object",
          "description": "En aquesta versió, només view. Només les diferències amb l'estil del document.",
          "properties": {
            "view": {
              "$ref": "#/$defs/partialView"
            }
          }
        },
        "pictograms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pictogram"
          }
        }
      }
    },
    "pictogram": {
      "type": "object",
      "required": [
        "id",
        "word",
        "image"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "word": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "cross": {
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/fitzgeraldCategory",
          "description": "Només si el pictograma en té."
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "style": {
          "type": "object",
          "description": "Només les diferències amb l'estil resolt de la seqüència. Mai view.",
          "properties": {
            "pictogram": {
              "$ref": "#/$defs/partialPictogramStyle"
            },
            "card": {
              "$ref": "#/$defs/partialCardStyle"
            }
          },
          "not": {
            "required": [
              "view"
            ]
          }
        }
      }
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source",
            "id"
          ],
          "properties": {
            "source": {
              "const": "arasaac"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variants": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "skin",
                  "hair",
                  "color"
                ]
              },
              "description": "Les opcions d'aparença que admet aquest pictograma d'ARASAAC (no tots tenen pell o cabell). És contingut. Sense la llista, les admet totes."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "asset"
          ],
          "properties": {
            "source": {
              "const": "own"
            },
            "asset": {
              "type": "string"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "description": "El pictograma d'ARASAAC que la imatge pròpia substitueix, per si es treu."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "none"
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "mime"
      ],
      "anyOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "mime": {
          "type": "string",
          "pattern": "^image/"
        },
        "data": {
          "type": "string",
          "pattern": "^data:image/"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "skin": {
      "enum": [
        "asian",
        "aztec",
        "black",
        "mulatto",
        "white"
      ]
    },
    "hair": {
      "enum": [
        "black",
        "blonde",
        "brown",
        "darkBrown",
        "gray",
        "darkGray",
        "red"
      ]
    },
    "textPosition": {
      "enum": [
        "top",
        "bottom",
        "none"
      ]
    },
    "alignmentH": {
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "alignmentV": {
      "enum": [
        "top",
        "center",
        "bottom"
      ]
    },
    "fitzgeraldCategory": {
      "enum": [
        "properNoun",
        "noun",
        "verb",
        "descriptive",
        "socialContent",
        "miscellaneous"
      ],
      "description": "Categoria de Fitzgerald de la paraula. És contingut, no estil."
    },
    "fitzgeraldColors": {
      "type": "object",
      "description": "Color de cada categoria de Fitzgerald, i `none` per als pictogrames sense categoria.",
      "required": [
        "properNoun",
        "noun",
        "verb",
        "descriptive",
        "socialContent",
        "miscellaneous",
        "none"
      ],
      "properties": {
        "properNoun": {
          "type": "string"
        },
        "noun": {
          "type": "string"
        },
        "verb": {
          "type": "string"
        },
        "descriptive": {
          "type": "string"
        },
        "socialContent": {
          "type": "string"
        },
        "miscellaneous": {
          "type": "string"
        },
        "none": {
          "type": "string"
        }
      }
    },
    "font": {
      "type": "object",
      "required": [
        "family",
        "color",
        "size"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "partialFont": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "border": {
      "type": "object",
      "required": [
        "color",
        "radius",
        "size"
      ],
      "properties": {
        "color": {
          "type": "string",
          "description": "Un color, o \"fitzgerald\"."
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "size": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "partialBorder": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "size": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fullStyle": {
      "type": "object",
      "description": "Estil del document o d'un fitxer d'estil: sempre complet.",
      "required": [
        "pictogram",
        "card",
        "view"
      ],
      "properties": {
        "pictogram": {
          "type": "object",
          "required": [
            "skin",
            "hair",
            "color",
            "fitzgerald"
          ],
          "properties": {
            "skin": {
              "$ref": "#/$defs/skin"
            },
            "hair": {
              "$ref": "#/$defs/hair"
            },
            "color": {
              "type": "boolean"
            },
            "fitzgerald": {
              "$ref": "#/$defs/fitzgeraldColors"
            }
          }
        },
        "card": {
          "type": "object",
          "required": [
            "numbered",
            "textPosition",
            "font",
            "numberFont",
            "borderIn",
            "borderOut"
          ],
          "properties": {
            "numbered": {
              "type": "boolean"
            },
            "textPosition": {
              "$ref": "#/$defs/textPosition"
            },
            "font": {
              "$ref": "#/$defs/font"
            },
            "numberFont": {
              "$ref": "#/$defs/font"
            },
            "borderIn": {
              "$ref": "#/$defs/border"
            },
            "borderOut": {
              "$ref": "#/$defs/border"
            }
          }
        },
        "view": {
          "type": "object",
          "required": [
            "sizePict",
            "pictSpaceBetween",
            "alignmentH",
            "alignmentV"
          ],
          "properties": {
            "sizePict": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pictSpaceBetween": {
              "type": "number",
              "minimum": 0
            },
            "alignmentH": {
              "$ref": "#/$defs/alignmentH"
            },
            "alignmentV": {
              "$ref": "#/$defs/alignmentV"
            }
          }
        }
      }
    },
    "partialPictogramStyle": {
      "type": "object",
      "properties": {
        "skin": {
          "$ref": "#/$defs/skin"
        },
        "hair": {
          "$ref": "#/$defs/hair"
        },
        "color": {
          "type": "boolean"
        },
        "fitzgerald": {
          "type": "string",
          "description": "Retoc: un sol color, que substitueix el de la categoria."
        }
      }
    },
    "partialCardStyle": {
      "type": "object",
      "properties": {
        "numbered": {
          "type": "boolean"
        },
        "textPosition": {
          "$ref": "#/$defs/textPosition"
        },
        "font": {
          "$ref": "#/$defs/partialFont"
        },
        "numberFont": {
          "$ref": "#/$defs/partialFont"
        },
        "borderIn": {
          "$ref": "#/$defs/partialBorder"
        },
        "borderOut": {
          "$ref": "#/$defs/partialBorder"
        }
      }
    },
    "partialView": {
      "type": "object",
      "properties": {
        "sizePict": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pictSpaceBetween": {
          "type": "number",
          "minimum": 0
        },
        "alignmentH": {
          "$ref": "#/$defs/alignmentH"
        },
        "alignmentV": {
          "$ref": "#/$defs/alignmentV"
        }
      }
    },
    "block": {
      "type": "object",
      "description": "Un bloc d'una pàgina. Un bloc d'un kind que l'app no coneix es conserva tal com és i es torna a escriure al seu lloc. Sense kind i amb sequence, és un bloc de seqüència (fases 1–3).",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "\"sequence\" o \"text\". Qualsevol altre valor és d'una versió posterior."
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "description": "L'espai de la plantilla de la pàgina que ocupa."
        },
        "namedStyle": {
          "type": "string",
          "description": "L'id d'un estil amb nom (styles). Si no hi és, el bloc fa servir l'estil del document."
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/sequenceBlock"
        },
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/foreignBlock"
        }
      ]
    },
    "sequenceBlock": {
      "description": "Un bloc de seqüència. Mil·límetres des del cantó superior esquerre del full (el paper menys el marge d'impressió); la caixa només és obligatòria a les pàgines amb plantilla i als comuns. Un bloc d'una seqüència que no hi és es descarta.",
      "required": [
        "kind",
        "sequence"
      ],
      "properties": {
        "kind": {
          "const": "sequence"
        },
        "sequence": {
          "type": "string",
          "description": "L'id de la seqüència."
        },
        "columns": {
          "description": "Columnes de la graella: \"auto\" (les que fan els pictogrames més grans) o un nombre fix. Sense valor, \"auto\".",
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "view": {
          "$ref": "#/$defs/partialView",
          "description": "Retoc de la vista en aquest bloc: només el que canvia respecte de la seqüència i de l'estil amb nom."
        }
      }
    },
    "textBlock": {
      "description": "Un bloc de text: un rètol sense pictograma. El text és contingut i no es tradueix.",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "description": "El text, amb \\n entre línies."
        },
        "textStyle": {
          "type": "object",
          "description": "Retoc sobre la lletra de les targetes (style.card.font i la de l'estil amb nom). Sense retoc, centrat i sense negreta.",
          "properties": {
            "font": {
              "$ref": "#/$defs/partialFont"
            },
            "bold": {
              "type": "boolean"
            },
            "alignmentH": {
              "$ref": "#/$defs/alignmentH"
            },
            "alignmentV": {
              "$ref": "#/$defs/alignmentV"
            }
          }
        }
      }
    },
    "foreignBlock": {
      "description": "Un bloc d'una versió posterior: es conserva tal com és.",
      "properties": {
        "kind": {
          "not": {
            "enum": [
              "sequence",
              "text"
            ]
          }
        }
      }
    },
    "namedStyle": {
      "type": "object",
      "description": "Un estil amb nom: un retoc de l'estil del document. Cascada: document → seqüència → estil amb nom del bloc → bloc → pictograma.",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pictogram": {
          "type": "object",
          "properties": {
            "skin": {
              "$ref": "#/$defs/skin"
            },
            "hair": {
              "$ref": "#/$defs/hair"
            },
            "color": {
              "type": "boolean"
            },
            "fitzgerald": {
              "type": "object",
              "description": "Taula parcial: els colors de les categories (i none) que canvia.",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "card": {
          "$ref": "#/$defs/partialCardStyle"
        },
        "view": {
          "$ref": "#/$defs/partialView"
        }
      }
    }
  }
}
