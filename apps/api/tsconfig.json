{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // Els tests no s'empaqueten: depenen de mongodb-memory-server, que és una
  // dependència de desenvolupament i no existeix al servidor de producció
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test"]
}
